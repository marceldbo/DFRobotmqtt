[Unit]
Description=Dfrobot UPS to MQTT
After=multi-user.target
StartLimitIntervalSec=610
StartLimitBurst=10

[Service]
WorkingDirectory=/path/to/repo/dfrobotmqtt
User=pi
Type=idle
ExecStart=/usr/bin/python3 /path/to/repo/dfrobotmqtt/dfrobotmqtt.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
